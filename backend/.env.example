# backend/.env.example

# ============================================
# APPLICATION
# ============================================
APP_NAME=Flood WebGIS HEC-RAS
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ============================================
# API
# ============================================
API_HOST=0.0.0.0
API_PORT=8000

# ============================================
# DATABASE (Neon PostgreSQL + PostGIS)
# ============================================
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:pass@host.neon.tech/flood_db?sslmode=require
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ============================================
# SECURITY
# ============================================
SECRET_KEY=change-me-in-production

# ============================================
# CORS
# ============================================
# Production: thêm domain Vercel/Render
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://hes-ras.idsea.net

# ============================================
# HEC-RAS API INTEGRATION
# ============================================
# Local dev: http://localhost:8000 (nếu HEC-RAS API cùng máy)
# Production: Cloudflare Tunnel URL (ví dụ https://hecras-agent.idsea.net)
HECRAS_API_URL=http://localhost:8000

# ============================================
# SIMULATION DEFAULTS
# ============================================
DEFAULT_RAINFALL_UNIT=mm
DEFAULT_DURATION_UNIT=hour
MAX_SIMULATION_DURATION=72