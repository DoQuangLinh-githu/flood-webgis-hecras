# backend/.env.example

# ============================================
# BACKEND CONFIGURATION
# ============================================

# Application
APP_NAME=Flood WebGIS HEC-RAS
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000

# CORS
CORS_ORIGINS=["http://localhost:5500", "http://127.0.0.1:5500"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"]
CORS_ALLOW_HEADERS=["Authorization", "Content-Type", "Accept", "X-Requested-With"]

# ============================================
# DATABASE - NEON POSTGRESQL
# ============================================

# Neon PostgreSQL Connection (REQUIRED)
DATABASE_URL=postgresql://username:password@host.neon.tech/database
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# ============================================
# SECURITY
# ============================================

SECRET_KEY=your-secret-key-change-in-production

# ============================================
# MOCK MODE
# ============================================

MOCK_MODE=False

# ============================================
# HEC-RAS INTEGRATION
# ============================================

# HEC-RAS API Service URL
# Nếu HEC-RAS chạy trên máy khác, thay IP bằng địa chỉ thật
HECRAS_API_URL=http://172.29.97.186:8000
HECRAS_MOCK_MODE=True

# ============================================
# SIMULATION DEFAULTS
# ============================================

DEFAULT_RAINFALL_UNIT=mm
DEFAULT_DURATION_UNIT=hour
MAX_SIMULATION_DURATION=72