# Backend Configuration
APP_NAME=Flood Simulation API
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flood_simulation
DB_USER=postgres
DB_PASSWORD=changeme
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Job Queue Configuration
JOB_QUEUE_TYPE=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# HEC-RAS Agent Configuration
AGENT_API_URL=http://localhost:8001
AGENT_REGISTRATION_TOKEN=your-registration-token

# Storage Configuration
STORAGE_TYPE=local
STORAGE_PATH=./storage
MAX_FILE_SIZE_MB=500

# GIS Configuration
DEFAULT_CRS=EPSG:4326
GEOTIFF_COMPRESSION=DEFLATE
COG_BLOCK_SIZE=512

# CORS
CORS_ORIGINS=["http://localhost:3000", "https://your-squarespace-site.com"]

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json