# .env.example (root) — dùng cho docker-compose và backend

# ============================================
# APPLICATION
# ============================================
APP_NAME=Flood WebGIS HEC-RAS
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://flood_user:flood_password@localhost:5432/flood_db
POSTGRES_USER=flood_user
POSTGRES_PASSWORD=flood_password
POSTGRES_DB=flood_db

# ============================================
# SECURITY
# ============================================
SECRET_KEY=change-me-in-production

# ============================================
# HEC-RAS API
# ============================================
HECRAS_API_URL=http://localhost:8000

# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8000