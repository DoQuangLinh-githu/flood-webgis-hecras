# agent/.env.example

# ============================================
# AGENT IDENTITY
# ============================================

AGENT_NAME=hecras-agent-01
AGENT_MACHINE_NAME=DESKTOP-KD5PFDG
AGENT_VERSION=1.0.0

# ============================================
# BACKEND CONNECTION
# ============================================

# Địa chỉ Backend (máy WebGIS)
BACKEND_URL=http://172.29.97.186:8000
AGENT_TOKEN=your-agent-secret-token-change-in-production
AGENT_API_KEY=your-agent-api-key-change-in-production

# ============================================
# POLLING CONFIGURATION
# ============================================

POLL_INTERVAL=30
HEARTBEAT_INTERVAL=60
JOB_TIMEOUT=3600

# ============================================
# WORKING DIRECTORY
# ============================================

WORKING_DIR=D:\\HECRAS\\Jobs
MODEL_TEMPLATE_DIR=D:\\HECRAS\\Models\\ModelTemplate

# ============================================
# HEC-RAS
# ============================================

HECRAS_EXECUTABLE=C:\\Program Files (x86)\\HEC\\HEC-RAS\\7.0.1\\Ras.exe
HECRAS_VERSION=7.0.1

# ============================================
# MOCK MODE
# ============================================

# True: Chạy giả lập (không chạy HEC-RAS thật)
# False: Chạy HEC-RAS thật
MOCK_MODE=True
MOCK_SIMULATION_DELAY=10

# ============================================
# LOGGING
# ============================================

LOG_LEVEL=INFO
LOG_FILE=logs/agent.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=10

# ============================================
# SECURITY
# ============================================

ALLOWED_COMMANDS=mkdir,copy,xcopy,echo,type,del,rmdir
ALLOWED_PATHS=D:\\HECRAS\\Jobs,D:\\HECRAS\\Models